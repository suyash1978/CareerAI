# Django Core Settings
SECRET_KEY=your-production-secret-key-here
DEBUG=False
ALLOWED_HOSTS=localhost,127.0.0.1

# Render automatically sets RENDER_EXTERNAL_HOSTNAME in production
# RENDER_EXTERNAL_HOSTNAME=your-app.onrender.com

# Database Settings (Render PostgreSQL automatically provides DATABASE_URL)
# DATABASE_URL=postgres://user:password@hostname:5432/dbname

# Frontend & CORS Settings
FRONTEND_URL=https://career-ai-psi-lemon.vercel.app
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,https://career-ai-psi-lemon.vercel.app

# Gemini AI Integration (Required for AI Features)
# Get your API Key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=your_gemini_api_key_here
