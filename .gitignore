# Root .gitignore for CareerAI Full-Stack Project

# Virtual Environment
.venv/
venv/
ENV/
env/
env.bak/
venv.bak/
backend/venv/

# Node & Frontend
node_modules/
frontend/node_modules/
frontend/dist/
frontend/dist-ssr/
*.local

# Python / Django
*.py[cod]
*$py.class
__pycache__/
*.so
.pytest_cache/
.coverage
htmlcov/
*.sqlite3
*.db
backend/db.sqlite3

# Uploaded Media Files
backend/media/*
!backend/media/.gitkeep

# Environment & Secrets
.env
*.env
.env.local
.env.development
.env.production
!.env.example
!*.env.example

# IDE & OS Specific
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
.antigravity/
.gemini/
